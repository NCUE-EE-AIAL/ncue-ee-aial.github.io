---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Art from '../components/Art.astro';
import { Font } from 'astro:assets';
import { s, localePath, stripLocale, otherLocale, htmlLang, type Locale } from '../i18n/utils';
import { site } from '../i18n/ui';
import { safeJsonLd, siteNodes, graph } from '../lib/seo.mjs';
interface Props {
  lang: Locale;
  title: string;
  description?: string;
  /** locale-less path of this page, e.g. "/people/". Defaults from the URL. */
  path?: string;
  ogType?: 'website' | 'article';
  /** Error pages: no canonical / hreflang, not indexed. */
  bare?: boolean;
  /** Extra JSON-LD nodes for this page (e.g. the PI on People), added to the site-wide graph. */
  jsonLd?: object[];
}
const { lang, title, description, ogType = 'website', bare = false } = Astro.props;
const path = Astro.props.path ?? stripLocale(Astro.url.pathname).path;
const siteName = s('name', lang);
const fullTitle = path === '/' && !bare ? `${siteName} · ${s('orgShort', lang)}` : `${title} · ${siteName}`;
const desc = description ?? s('description', lang);
const canonical = new URL(localePath(path, lang), Astro.site);
const other = otherLocale(lang);
const origin = new URL('/', Astro.site).origin;
const csp = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  'frame-src https://www.youtube-nocookie.com',
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
const ld = bare ? '' : safeJsonLd(graph([
  ...siteNodes({
    origin, lang, inLanguage: htmlLang[lang], home: new URL(localePath('/', lang), Astro.site).href,
    name: site.name, email: site.email, address: site.address,
    logo: new URL('/apple-touch-icon.png', Astro.site).href, sameAs: [site.github, site.facebook],
  }),
  ...(Astro.props.jsonLd ?? []),
]));
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <!-- GitHub Pages cannot send headers, so the policy is a meta tag (frame-ancestors is ignored there).
         Everything is served from this origin; the only third party is the click-to-load YouTube player. -->
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {bare ? <meta name="robots" content="noindex" /> : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang={htmlLang.en} href={new URL(localePath(path, 'en'), Astro.site)} />
        <link rel="alternate" hreflang={htmlLang.zh} href={new URL(localePath(path, 'zh'), Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(localePath(path, 'en'), Astro.site)} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={s('ogImageAlt', lang)} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_TW' : 'en_US'} />
    <meta property="og:locale:alternate" content={other === 'zh' ? 'zh_TW' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    {site.verification.google && <meta name="google-site-verification" content={site.verification.google} />}
    {site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
    <link rel="alternate" type="application/rss+xml" title={`${siteName} · ${lang === 'zh' ? '最新消息' : 'News'}`} href={localePath('/rss.xml', lang)} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f1117" />
    {ld && <script type="application/ld+json" set:html={ld} />}
    <Font cssVariable="--font-inter" preload />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') {
            root.dataset.theme = t;
            var metas = document.querySelectorAll('meta[name="theme-color"]');
            for (var i = 0; i < metas.length; i++) metas[i].setAttribute('content', t === 'dark' ? '#0f1117' : '#ffffff');
          }
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <Art name="defs" />
    <Art name="bench" class="art-bench" />
    <a class="skip-link" href="#main">{lang === 'zh' ? '跳至主內容' : 'Skip to content'}</a>
    <Nav lang={lang} path={path} />
    <main id="main" data-pagefind-body={bare ? undefined : true}>
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline>
      // Fade-up for .reveal blocks as they scroll into view; everything shows at once under reduced motion.
      (function () {
        var els = document.querySelectorAll('.reveal');
        var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (still || !('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -6% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
    {site.goatcounter && !bare && (
      <script is:inline define:vars={{ endpoint: `https://${site.goatcounter}.goatcounter.com/count` }}>
        // One page view per load: path, referrer and title only, no cookies (GoatCounter's no-JS-library endpoint).
        if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
          var q = '?p=' + encodeURIComponent(location.pathname) + '&t=' + encodeURIComponent(document.title)
            + '&r=' + encodeURIComponent(document.referrer) + '&rnd=' + Math.random().toString(36).slice(2);
          new Image().src = endpoint + q;
        }
      </script>
    )}
  </body>
</html>
