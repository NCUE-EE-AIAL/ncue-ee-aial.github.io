---
/**
 * A project's diagram from src/assets/project-art/<id>.svg (made by scripts/project-art-gen.mjs), inlined so it
 * takes the theme's colours. Renders nothing for a project without a drawing. Decorative: the card's title and
 * summary say the same thing in words. Styles under "Project diagrams" in global.css.
 */
const files = import.meta.glob<string>('../assets/project-art/*.svg', { query: '?raw', import: 'default', eager: true });
interface Props { id: string }
const svg = files[`../assets/project-art/${Astro.props.id}.svg`];
---
{svg && <div class="project-art" aria-hidden="true" set:html={svg}></div>}
<script>
  // Once a card has drawn itself in, mark it, so that leaving a hover does not replay the scroll-in drawing.
  document.addEventListener('animationend', (e) => {
    if (e.animationName === 'project-draw' && e.target instanceof Element) e.target.closest('.project')?.classList.add('drawn');
  });
</script>
