---
import Icon from './Icon.astro';
import { pick, t, type Locale, type UiKey } from '../i18n/utils';
import { isAuthor, toBibtex } from '../lib/format';
import type { Publication } from '../lib/data';
interface Props {
  pub: Publication;
  lang: Locale;
  /** English names of lab members; their names are set in bold. */
  members: string[];
  showYear?: boolean;
  /** Give the item an id so People cards can link to it. */
  anchor?: boolean;
  /** Titles of honours this paper won (src/content/honors/ with `publication`). */
  awards?: string[];
}
const { pub, lang, members, showYear = false, anchor = false, awards = [] } = Astro.props;
const d = pub.data;
const title = pick(d.title, lang);
const altTitle = lang === 'zh' && d.title.zh ? d.title.en : undefined;
const href = d.url ?? (d.doi ? `https://doi.org/${d.doi}` : undefined);
const bib = toBibtex({ title: d.title.en, authors: d.authors, venue: d.venue, year: d.year, type: d.type, doi: d.doi, url: d.url });
const isMember = (a: string) => members.some((m) => isAuthor(m, [a]));
---
<li class="pub" data-type={d.type} data-verified={String(d.verified)} id={anchor ? pub.id : undefined}>
  <p class="pub-title">{href ? <a href={href} rel="noopener">{title}</a> : title}</p>
  {altTitle && <p class="pub-title-alt" lang="en">{altTitle}</p>}
  <p class="pub-authors">{d.authors.map((a, i) => <>{i > 0 && ', '}{isMember(a) ? <strong class="me">{a}</strong> : a}</>)}</p>
  <p class="pub-venue">{d.venue}{showYear && !d.venue.includes(String(d.year)) && `, ${d.year}`}</p>
  <div class="pub-links">
    <span class="chip">{t(`pubs.type.${d.type}` as UiKey, lang)}</span>
    {awards.map((a) => <span class="chip chip-award"><Icon name="star" /> {a}</span>)}
    {!d.verified && <span class="chip chip-warn">{t('pubs.unverified', lang)}</span>}
    {d.doi && <a href={`https://doi.org/${d.doi}`} rel="noopener">{t('pubs.doi', lang)}</a>}
    {d.pdf && <a href={d.pdf}>{t('pubs.pdf', lang)}</a>}
    {d.code && <a href={d.code} rel="noopener">{t('pubs.code', lang)}</a>}
    <button type="button" class="bib-copy" data-bibtex={bib} data-copied={t('pubs.copied', lang)} data-failed={t('pubs.copyFailed', lang)}>
      <Icon name="copy" /><span class="bib-label" aria-live="polite">{t('pubs.bibtex', lang)}</span>
    </button>
  </div>
</li>
<script>
  function legacyCopy(text: string): boolean {
    const area = document.createElement('textarea');
    area.value = text;
    area.setAttribute('readonly', '');
    area.style.position = 'fixed';
    area.style.opacity = '0';
    document.body.append(area);
    area.select();
    let ok = false;
    try { ok = document.execCommand('copy'); } catch { ok = false; }
    area.remove();
    return ok;
  }
  document.addEventListener('click', async (event) => {
    const btn = (event.target as Element | null)?.closest<HTMLButtonElement>('button[data-bibtex]');
    if (!btn) return;
    const text = btn.dataset.bibtex ?? '';
    let ok = false;
    try {
      await navigator.clipboard.writeText(text);
      ok = true;
    } catch {
      ok = legacyCopy(text);
    }
    const label = btn.querySelector('.bib-label');
    if (!label) return;
    const original = label.textContent;
    label.textContent = (ok ? btn.dataset.copied : btn.dataset.failed) ?? '';
    window.setTimeout(() => { label.textContent = original; }, 1800);
  });
</script>
