---
import { formatDate, localePath, htmlLang, t, type Locale } from '../i18n/utils';
import { slugOf, langOf } from '../lib/format';
import type { NewsPost } from '../lib/data';
interface Props { post: NewsPost; lang: Locale; level?: 2 | 3 }
const { post, lang, level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
// A post written only in the other language is shown as is, tagged with its language.
const postLang = langOf(post.id) as Locale;
const foreign = postLang !== lang ? htmlLang[postLang] : undefined;
---
<article class="news-item">
  <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date, lang)}</time>
  <div>
    <H class="news-title" lang={foreign}><a href={localePath(`/news/${slugOf(post.id)}/`, lang)}>{post.data.title}</a></H>
    {post.data.summary && <p class="news-summary" lang={foreign}>{post.data.summary}</p>}
    {foreign && <p class="news-lang">{t('news.onlyIn', lang)}</p>}
  </div>
</article>
