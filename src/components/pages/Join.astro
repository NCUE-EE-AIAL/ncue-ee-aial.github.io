---
import Base from '../../layouts/Base.astro';
import PageHead from '../PageHead.astro';
import Cta from '../Cta.astro';
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';
import labSign from '../../assets/photos/lab-sign.jpg';
import { formatDate, pick, s, t, type Locale, type UiKey } from '../../i18n/utils';
import { site } from '../../i18n/ui';
import { getFacilities, getPeople, getFaq, getAlbums } from '../../lib/data';
interface Props { lang: Locale }
const { lang } = Astro.props;
const [facilities, people, faq, albums] = await Promise.all([getFacilities(), getPeople(), getFaq(), getAlbums()]);
const audiences = (['master', 'undergrad', 'intl', 'all'] as const).filter((a) => faq.some((f) => f.data.audience === a));
const piEmail = people.find((p) => p.data.role === 'pi')?.data.links.email;
// TODO markers (unconfirmed facts) show in `npm run dev` only, never on the public site.
const showTodo = import.meta.env.DEV;
const room = s('room', lang);
const roomKnown = !room.startsWith('TODO');
---
<Base lang={lang} title={t('join.title', lang)} path="/join/" description={t('join.intro', lang)}>
  <PageHead title={t('join.title', lang)} lede={t('join.intro', lang)} art="join" />

  <section class="container join-paths" aria-labelledby="paths-h">
    <h2 id="paths-h" class="sr-only">{t('join.paths.title', lang)}</h2>
    <article class="join-path reveal" aria-labelledby="students-h">
      <span class="join-path-icon"><Icon name="scholar" /></span>
      <h3 id="students-h">{t('join.students.title', lang)}</h3>
      <p>{t('join.students.body', lang)}</p>
      {piEmail && (
        <div class="join-path-actions">
          <a class="btn" href={`mailto:${piEmail}`}><Icon name="mail" /> {t('cta.pi', lang)}</a>
        </div>
      )}
    </article>
    <article class="join-path reveal" style="--i: 1" aria-labelledby="intl-h">
      <span class="join-path-icon"><Icon name="globe" /></span>
      <h3 id="intl-h">{t('join.intl.title', lang)}</h3>
      <p>{t('join.intl.body', lang)}</p>
      <div class="join-path-actions">
        <a class="btn" href={`mailto:${site.email}`}><Icon name="mail" /> {t('cta.lab', lang)}</a>
        {faq.length > 0 && <a class="join-path-more" href="#faq">{t('join.faq.title', lang)} <Icon name="arrow" /></a>}
      </div>
    </article>
  </section>

  <section class="join-contact" id="contact" aria-labelledby="contact-h">
    <div class="container join-contact-inner">
      <div class="join-contact-main">
        <h2 id="contact-h">{t('join.contact.title', lang)}</h2>
        <dl class="contact-list">
          <div>
            <dt><Icon name="mail" /> {t('join.email.lab', lang)}</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          {piEmail && (
            <div>
              <dt><Icon name="mail" /> {t('join.email.pi', lang)}</dt>
              <dd><a href={`mailto:${piEmail}`}>{piEmail}</a></dd>
            </div>
          )}
          <div>
            <dt><Icon name="phone" /> {t('join.phone', lang)}</dt>
            <dd><a href={`tel:${site.tel}`}>{s('phone', lang)}</a></dd>
          </div>
          <div>
            <dt><Icon name="building" /> {t('join.address', lang)}</dt>
            <dd>{s('org', lang)}<br />{(roomKnown || showTodo) && <><span class:list={[{ todo: !roomKnown }]}>{room}</span><br /></>}{s('address', lang)}</dd>
          </div>
          <div>
            <dt><Icon name="pin" /> {t('join.directions', lang)}</dt>
            <dd>
              <ul class="contact-links">
                <li><a href={site.map} rel="noopener">{t('join.map', lang)} <Icon name="external" /></a></li>
                <li><a href={site.directions} rel="noopener" hreflang={lang === 'en' ? 'zh-Hant-TW' : undefined}>{t('join.transport', lang)} <Icon name="external" /></a></li>
              </ul>
            </dd>
          </div>
          <div>
            <dt><Icon name="link" /> {t('join.links', lang)}</dt>
            <dd>
              <ul class="contact-links">
                <li><a href={site.github} rel="noopener"><Icon name="github" /> GitHub</a></li>
                <li><a href={site.facebook} rel="noopener"><Icon name="facebook" /> Facebook</a></li>
                <li><a href={`${site.repo}/issues/new/choose`} rel="noopener"><Icon name="external" /> {t('join.issue', lang)}</a></li>
              </ul>
            </dd>
          </div>
        </dl>
      </div>
      {roomKnown && (
        <Photo src={labSign} alt={t('join.sign.alt', lang)} width={420} sizes="(min-width: 860px) 360px, 100vw"
          caption={t('join.sign.caption', lang)} class="lab-sign" />
      )}
    </div>
  </section>

  {albums.length > 0 && (
    <section class="container join-section" aria-labelledby="life-h">
      <div class="join-section-head">
        <h2 id="life-h">{t('join.life.title', lang)}</h2>
        <p>{t('join.life.body', lang)}</p>
      </div>
      <div class="albums">
        {albums.map((a) => (
          <article class="album" id={`album-${a.id}`}>
            <header class="album-head">
              <time class="album-date" datetime={a.data.date.toISOString().slice(0, 10)}>{formatDate(a.data.date, lang)}</time>
              <h3 class="album-title">{pick(a.data.title, lang)}</h3>
              {a.data.summary && <p class="album-summary">{pick(a.data.summary, lang)}</p>}
            </header>
            <div class:list={['album-photos', { 'album-photos-single': a.data.photos.length === 1 }]}>
              {a.data.photos.map((p) => (
                <Photo src={p.src} alt={pick(p.alt, lang)} width={a.data.photos.length === 1 ? 960 : 480}
                  sizes={a.data.photos.length === 1 ? '(min-width: 860px) 700px, 100vw' : '(min-width: 860px) 350px, 50vw'}
                  caption={p.caption && pick(p.caption, lang)} />
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {(faq.length > 0 || facilities.length > 0) && (
    <div class="container join-section join-split">
      {faq.length > 0 && (
        <section id="faq" aria-labelledby="faq-h">
          <h2 id="faq-h">{t('join.faq.title', lang)}</h2>
          {audiences.map((a) => (
            <div class="faq-group">
              <h3 class="faq-audience">{t(`join.faq.${a}` as UiKey, lang)}</h3>
              {faq.filter((f) => f.data.audience === a).map((f) => (
                <details class="faq">
                  <summary>{pick(f.data.q, lang)}</summary>
                  <p>{pick(f.data.a, lang)}</p>
                </details>
              ))}
            </div>
          ))}
        </section>
      )}
      {facilities.length > 0 && (
        <section id="facilities" aria-labelledby="facilities-h">
          <h2 id="facilities-h">{t('join.facilities.title', lang)}</h2>
          <p class="muted">{t('join.facilities.intro', lang)}</p>
          <ul class="facility-list">
            {facilities.map((f) => (
              <li class="facility">
                <span class="facility-cat">{t(`facility.${f.data.category}` as UiKey, lang)}</span>
                <span class="facility-name">{pick(f.data.name, lang)}{f.data.qty && <span class="facility-qty"> × {f.data.qty}</span>}</span>
                {f.data.note && <span class="facility-note">{pick(f.data.note, lang)}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  )}
  <Cta lang={lang} showJoin={false} />
</Base>
