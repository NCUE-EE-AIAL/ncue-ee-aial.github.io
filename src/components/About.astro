---
import Photo from './Photo.astro';
import { t, pick, type Locale, type UiKey } from '../i18n/utils';
import { ayLabel } from '../lib/format';
import type { Stat, GroupPhoto } from '../lib/data';
/** Home "About the lab": the introduction, the newest yearly group photo (if any) and numbers counted at build time. */
interface Props { lang: Locale; stats: Stat[]; group?: GroupPhoto }
const { lang, stats, group } = Astro.props;
const g = group?.data;
const paragraphs = [t('home.about.p1', lang), t('home.about.p2', lang)].filter((p) => p.trim() !== '');
---
{(paragraphs.length > 0 || stats.length > 0) && (
  <section class:list={['section container about', { 'has-photo': g }]} id="about" aria-labelledby="about-h">
    <div class="about-text reveal">
      <h2 id="about-h">{t('home.about', lang)}</h2>
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
    {g && (
      <Photo src={g.photo.src} alt={pick(g.photo.alt, lang)} width={620} eager class="about-photo reveal"
        sizes="(min-width: 1080px) 520px, (min-width: 860px) 46vw, 100vw"
        caption={`${g.year} · ${t('home.about.groupCaption', lang)}${g.names ? ` — ${pick(g.names, lang)}` : ''}`} />
    )}
    {stats.length > 0 && (
      <ul class="stats reveal">
        {stats.map((s) => (
          <li class="stat" data-stat={s.key}>
            <span class="stat-n">{s.n}</span>
            <span class="stat-label">{t(`stats.${s.key}` as UiKey, lang)}</span>
            {s.sinceAy !== undefined && <span class="stat-sub">{t('stats.since', lang).replace('{ay}', ayLabel(s.sinceAy, lang))}</span>}
          </li>
        ))}
      </ul>
    )}
  </section>
)}
<script>
  // The numbers count up once as they scroll in. The built page holds the real numbers, so without JS, under reduced
  // motion and for screen readers (a hidden copy of each number) nothing changes.
  const stats = document.querySelector('.about .stats');
  if (stats && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const nums = [...stats.querySelectorAll<HTMLElement>('.stat-n')].map((el) => ({ el, n: Number(el.textContent) }))
      .filter((s) => Number.isInteger(s.n) && s.n > 0);
    nums.forEach(({ el, n }) => {
      const copy = Object.assign(document.createElement('span'), { className: 'sr-only', textContent: String(n) });
      el.after(copy);
      el.setAttribute('aria-hidden', 'true');
      el.textContent = '0';
    });
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const start = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - start) / 1100), ease = 1 - (1 - p) ** 3;
        nums.forEach(({ el, n }) => { el.textContent = String(Math.round(n * ease)); });
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }, { rootMargin: '0px 0px -10% 0px' });
    io.observe(stats);
  }
</script>
